app/configuration/api.json
app/configuration/settings.json
app/configuration/characters.json

# Soul Stage runtime data (scenes, NPC memory) - user/session state, not source
.soul_stage/

# User-supplied runtime assets (backgrounds, ambient sounds, avatars, models, etc.)
# Keep folder placeholders (.gitkeep) so the directories still exist after checkout.
assets/ambient/*
!assets/ambient/.gitkeep
assets/backgrounds/*
!assets/backgrounds/.gitkeep
assets/emotions/images/*
!assets/emotions/images/.gitkeep
assets/emotions/live2d/*
!assets/emotions/live2d/.gitkeep
assets/emotions/vrm/*
!assets/emotions/vrm/.gitkeep
assets/local_llm/*
!assets/local_llm/.gitkeep
assets/rvc_models/*
!assets/rvc_models/.gitkeep

app/cache
app/data/.soul

# Pixi related files (generated by Pixi build system)
.pixi
.pixi-bin

# Anything with "temp" anywhere in the name (any case), files or directories
*[Tt][Ee][Mm][Pp]*

# Stray hash-named temp artifacts occasionally dropped in app/utils/ai_clients
# (40 lowercase-hex characters, no extension). Rest of the directory is real source.
app/utils/ai_clients/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]
